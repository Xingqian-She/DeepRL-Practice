{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 调试当前文件（容器内）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "CartPole: 弹窗验证（容器内）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/smoke_test.py",
      "args": ["--mode", "human"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
